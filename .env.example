# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never put a real key here.
#
# WARNING: anything prefixed VITE_ is inlined into the client bundle and is readable by anyone
# who opens the page. That is acceptable for a laptop at a booth. It is NOT safe for a hosted
# deployment -- if this ever goes on a public URL, these calls must move behind a server that
# holds the key.

VITE_OPENAI_API_KEY=

# Optional. Model ids change often; check the current list rather than trusting a default.
# VITE_OPENAI_MODEL=gpt-4.1-mini
