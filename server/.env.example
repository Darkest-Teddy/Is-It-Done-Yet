# Copy to `.env` (gitignored) and fill in. Every value here has a working default EXCEPT
# MONGODB_URI, and leaving that unset is a supported mode: the server then starts its own
# embedded MongoDB and seeds it, so `npm install && npm run dev` works with nothing installed.

# Atlas or any mongod. Unset = embedded development database in server/.data/.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

DB_NAME=isitdone
PORT=3000

# Comma-separated ORIGINS -- scheme, host and port, never a path. Empty means any origin, which
# is right locally and wrong in production.
# ALLOWED_ORIGIN=https://darkest-teddy.github.io
ALLOWED_ORIGIN=

# Number of proxy hops to trust, or true/false. Set to 1 behind Render, Railway or Fly, or the
# rate limiter buckets the whole venue under the proxy's address.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_WRITES=120

# Optional. When set, POST /api/recipes requires header `x-api-key`. Score submission stays open.
WRITE_KEY=
