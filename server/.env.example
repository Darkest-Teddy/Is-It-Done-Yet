# Copy to `.env` (gitignored) and fill in. Every value here has a working default EXCEPT
# MONGODB_URI, and leaving that unset is a supported mode: the server then starts its own
# embedded MongoDB and seeds it, so `npm install && npm run dev` works with nothing installed.

# Atlas or any mongod. Unset = embedded development database in server/.data/.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

DB_NAME=isitdone
PORT=3000

# Comma-separated ORIGINS -- scheme, host and port, never a path. Empty means any origin, which
# is right locally and wrong in production.
# ALLOWED_ORIGIN=https://darkest-teddy.github.io
ALLOWED_ORIGIN=

# Number of proxy hops to trust, or true/false. Set to 1 behind Render, Railway or Fly, or the
# rate limiter buckets the whole venue under the proxy's address.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_WRITES=120

# Optional. When set, POST /api/recipes requires header `x-api-key`. Score submission stays open.
WRITE_KEY=

# ---------------------------------------------------------------------------
# The coach's vision model.
#
# The headset NEVER calls a model. It posts a frame to this server and this server holds the
# key -- which is the whole reason the key name lives here and the key itself lives in .env.
# ---------------------------------------------------------------------------

# Any OpenAI-compatible /chat/completions endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1

# The NAME of the variable holding the key, not the key. src/llm.js reads process.env[this].
# Set GROQ_API_KEY (or whatever you name here) in .env, never in this file.
LLM_API_KEY_ENV_NAME=GROQ_API_KEY
GROQ_API_KEY=

# Groq's documented vision model: 27B open-weight Qwen multimodal, 131K context, JSON mode,
# 3 images per request. Groq RETIRES models -- check https://console.groq.com/docs/vision when
# the coach starts reporting offline with a 404 from upstream.
COACH_MODEL=qwen/qwen3.8-27b

# Instruct mode. Qwen 3.8 ships thinking and instruct in one model and defaults to thinking;
# a chain of thought in front of four JSON fields costs seconds the 3-second loop lacks.
# Leave EMPTY to omit the field for a provider that rejects it.
LLM_REASONING_EFFORT=none

LLM_TIMEOUT_MS=12000
LLM_MAX_RETRIES=2
# Ceiling on the decoded image. The headset aims for ~60KB.
LLM_MAX_IMAGE_BYTES=400000

# Optional second provider, tried only when the first fails. Unset = no fallback.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY_ENV_NAME=LLM_FALLBACK_API_KEY
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_REASONING_EFFORT=

# Per-window ceiling on the routes that cost money, separate from RATE_LIMIT_MAX_WRITES.
RATE_LIMIT_MAX_COACH=60

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# HMAC key for session tokens. Unset = a random key per boot, which is the right default:
# tokens then die with the process instead of being signed by a key that shipped in a repo.
# Set it only when running more than one instance behind a load balancer.
SESSION_SECRET=

# Floor on any run, before the recipe's own timed steps are considered.
MIN_RUN_SECONDS=20
MAX_RUN_SECONDS=14400

# Recorded sessions carry photographs of somebody's kitchen. They expire. This is the window.
SESSION_TTL_DAYS=7
